.venv/
__pycache__/
*.pyc
inbox/*
!inbox/.gitkeep
archive/done/*
!archive/done/.gitkeep
archive/failed/*
!archive/failed/.gitkeep
logs/*
!logs/.gitkeep
*.log
history/
hist/

# 例外：skill 包内的 references/history 属于内容，必须跟踪
!skills-src/**/history/
!skills-src/**/history/**

# runtime bot configs may be local-only (examples stay tracked)
config/bots/llm-test.yaml

# monorepo: pa-data-source runtime (never commit data/secrets)
pa-data-source/data/
pa-data-source/logs/
pa-data-source/aux-data/
pa-data-source/gate-cli.exe
pa-data-source/__pycache__/
pa-data-source/*.lock

# test residue
.market_read_test/
.order_type_test/
.full_chain_test/
.prod_test/
.prod_e2e/
.multi_prod/
.multi_bot_test/
.smoke_inbox/
.soak_test/
.playwright-cli/
.worktrees/
.prelaunch_test/
*.zip

# runtime bot data (layout v2)
data/bots/
data/bots.db
data/bots.db-shm
data/bots.db-wal
*.egg-info/

data/
.worktrees/
research/**/deflated-sharpe.pdf
research/**/backtest-pseudo.pdf
research/**/sharpe-frontier.pdf

# 告警配置含密钥
config/alerts.yaml

# secrets — never commit
scripts/secrets.bat
.env
.env.*
*.key
*.pem

# SkillKit: runtime skill install dir (install via \gate_bot skill install\)
skills/*
!skills/.gitkeep

# SkillKit: audit journal
logs/skill_journal.jsonl*

# dev script output artifacts / key-handling one-offs
scripts/_*.txt
scripts/_*.json
scripts/_gate_env.tmp
scripts/_export_gate_keys.py

# 环境差异 overlay（每台机器一份，不入库）
config/bots.local/
config/.bots-backup/
